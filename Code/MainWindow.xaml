<Window
    x:Class="Code.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Code"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="MainWindow"
    Width="1000"
    Height="300"
    MinWidth="1000"
    MinHeight="300"
    mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="225" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>


        <Border
            Grid.Column="0"
            Margin="5"
            BorderBrush="Black"
            BorderThickness="1"
            CornerRadius="5">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <StackPanel
                    Margin="10"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Orientation="Vertical">
                    <Button
                        Width="150"
                        Height="30"
                        Margin="0,0,0,10"
                        Click="Button_CustomerStats_Click"
                        Content="Customer Statistics" />

                    <Button
                        Width="150"
                        Height="30"
                        Margin="0,0,0,10"
                        Click="Button_CashflowEstim_Click"
                        Content="Cashflow Estimation" />

                    <Button
                        Width="150"
                        Height="30"
                        Margin="0,0,0,10"
                        Click="Button_RegionDistrib_Click"
                        Content="Region Distribution" />

                    <Button
                        Width="150"
                        Height="30"
                        Margin="0,0,0,10"
                        Click="Button_PaymentMethod_Click"
                        Content="Payment Method" />

                </StackPanel>
            </ScrollViewer>
        </Border>

        <Border
            Grid.Column="1"
            Margin="5"
            BorderBrush="Black"
            BorderThickness="1"
            CornerRadius="5">
            <Frame
                x:Name="MainFrame"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                NavigationUIVisibility="Hidden" />

        </Border>


    </Grid>
</Window>
