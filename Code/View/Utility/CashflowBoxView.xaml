<Window
    x:Class="Code.View.Utility.CashflowBoxView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Code.View.Utility"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vmu="clr-namespace:Code.ViewModel.Utility"
    Title="CashflowBoxView"
    Width="250"
    Height="300"
    ResizeMode="NoResize"
    mc:Ignorable="d">

    <Window.DataContext>
        <vmu:CashflowBoxViewModel />
    </Window.DataContext>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border
            Grid.Column="0"
            Margin="10"
            Background="White"
            BorderBrush="Black"
            BorderThickness="1"
            CornerRadius="5">


            <StackPanel
                Margin="20"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Center">

                <TextBlock
                    Margin="0,0,0,10"
                    HorizontalAlignment="Center"
                    Text="Select the range of the prediction:"
                    TextWrapping="Wrap" />


                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="auto" />
                    </Grid.ColumnDefinitions>

                    <Slider
                        Grid.Column="0"
                        IsSnapToTickEnabled="True"
                        Maximum="6"
                        Minimum="1"
                        TickFrequency="1"
                        Value="{Binding PredictionRange}" />

                    <TextBlock
                        Grid.Column="1"
                        Margin="0,0,0,10"
                        HorizontalAlignment="Center"
                        Text="{Binding PredictionRange, Mode=TwoWay}" />
                </Grid>


                <Separator
                    Height="1"
                    Margin="0,0,0,10"
                    Background="Black" />

                <Button
                    Name="GenerateReportButton"
                    Width="150"
                    Height="30"
                    Margin="0,0,0,10"
                    Click="GenerateReportButton_Click"
                    Content="Generate Report" />

            </StackPanel>
        </Border>

    </Grid>
</Window>
